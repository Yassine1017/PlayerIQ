# Development placeholders only. Never commit a populated .env.
DATABASE_URL=postgresql+psycopg://playeriq_api_login:replace-me@localhost:5432/playeriq
WORKER_DATABASE_URL=postgresql+psycopg://playeriq_worker_login:replace-me@localhost:5432/playeriq
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_STORAGE_SECRET_KEY=replace-with-server-only-secret
SUPABASE_STORAGE_BUCKET=playeriq-reports
JWKS_CACHE_SECONDS=300
MAX_UPLOAD_BYTES=10485760
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]
MAX_VELOCITY_REVIEW_KMH=45
DISTANCE_PEER_REVIEW_MULTIPLIER=3
OPENAI_API_KEY=replace-with-server-only-key
OPENAI_MODEL=gpt-6-luna
AI_REQUEST_TIMEOUT_SECONDS=25
AI_MAX_TOOL_CALLS=4
AI_MAX_PROVIDER_ATTEMPTS=2
AI_MAX_QUESTION_LENGTH=600
AI_MAX_CONTEXT_MESSAGES=6
AI_MAX_RESULT_FACTS=24
AI_MAX_SESSION_RESULTS=10
AI_MAX_RESPONSE_LENGTH=1200
AI_MAX_DATE_RANGE_DAYS=366
AI_DAILY_RUN_LIMIT=20
